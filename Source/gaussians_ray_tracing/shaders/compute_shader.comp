#version 430 core

layout (local_size_x = 8, local_size_y = 4, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D out_tex;

struct EllipsoidGeneral
{
    vec4 mu;
    vec4 sigma;
    mat4 rotation;
    mat4 covariance_invariant;
};

struct EllipsoidAddtitional
{
    float sh_main[3];
    float sh_add[45];
    float opacity;
};

struct BVH_Node
{
    float bounds[6];
    int index_left;
    int index_right;
    int primitive_counts;
    int primitive_index;
};

layout(std430, binding = 1) buffer EllipsoidsGeneral
{
    EllipsoidGeneral ellipsoid_general[];
};

layout(std430, binding = 2) buffer EllipsoidsAddtitional
{
    EllipsoidAddtitional ellipsoid_addtitional[];
};

layout(std430, binding = 3) buffer BVH_Nodes
{
    BVH_Node nodes[];
};

layout(std430, binding = 4) buffer BVH_Indices
{
    uint prim_ids[];
};

uniform vec3 camera_pos;
uniform vec3 camera_front;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform float fov;
uniform float aspect;
uniform float Q;
uniform vec3 light_pos;
uniform int ellipsoid_count;

float intersect_aabb(vec3 center, vec3 inv_dir, vec3 min_box, vec3 max_box)
{
    vec3 t_min = (min_box - center) * inv_dir;
    vec3 t_max = (max_box - center) * inv_dir;

    vec3 tmin_vec = min(t_min, t_max);
    vec3 tmax_vec = max(t_min, t_max);

    float tmin = max(max(tmin_vec.x, tmin_vec.y), tmin_vec.z);
    float tmax = min(min(tmax_vec.x, tmax_vec.y), tmax_vec.z);

    // ≈сли нет пересечени€ или box позади луча
    if (tmax < 0.0 || tmin > tmax) return -1.0;
    
    // ¬озвращаем точку входа (или 0 если луч начинаетс€ внутри)
    return max(tmin, 0.0);
}

float intersect_ellipsoid(
    mat3 L,
    vec3 sigma,
    vec3 mu,
    vec3 center,
    vec3 direction,  // должен быть нормализован!
    float scale
) { 
    // ѕреобразуем в пространство сферы
    vec3 e_sphere = L * (center - mu);
    vec3 d_sphere = L * direction;
    
    float d_dot_d = dot(d_sphere, d_sphere);
    float o_dot_d = dot(e_sphere, d_sphere);

    float t_ca = -o_dot_d / d_dot_d;

    vec3 closest_point = e_sphere + t_ca * d_sphere;
    float d2 = dot(closest_point, closest_point);

    float Q2 = scale * scale;

    if (d2 <= Q2) {

            float t_hc = sqrt(Q2 - d2) / sqrt(d_dot_d);
    
            float t1 = t_ca - t_hc;
            float t2 = t_ca + t_hc;

            return (t1 >= 0.0) ? t1 : t2; // ¬озвращаем ближайшее положительное пересечение
    }
    else
    {
        return -1.0; // Ќет пересечени€
    }
}

struct HitInfo
{
    float t;
    uint prim_id;
    float response;
};

void traverse_bvh(vec3 center, vec3 direction, inout vec4 pixel_color, inout float closest_hit)
{
    vec3 inv_dir = 1.0 / direction;
    
    int stack[64];
    int stack_ptr = 0;
    stack[stack_ptr++] = 0;

    while (stack_ptr > 0)
    {
        int node_index = stack[--stack_ptr];
        BVH_Node node = nodes[node_index];

        vec3 bounds_min = vec3(node.bounds[0], node.bounds[2], node.bounds[4]);
        vec3 bounds_max = vec3(node.bounds[1], node.bounds[3], node.bounds[5]);
        
        float t_hit = intersect_aabb(center, inv_dir, bounds_min, bounds_max);
        
        // ѕропускаем если нет пересечени€ или оно дальше уже найденного
        if (t_hit < 0.0 || t_hit >= closest_hit)
            continue;

        // ≈сли это листовой узел
        if (node.primitive_counts > 0)
        {
            HitInfo hit_info[8];
            int hit_count = 0;

            for (int i = 0; i < node.primitive_counts; i++)
            {
                uint prim_id = prim_ids[node.primitive_index + i];
                
                EllipsoidGeneral eg = ellipsoid_general[prim_id];
                
                mat3 L = mat3(eg.covariance_invariant);
                vec3 mu = eg.mu.xyz;
                vec3 sigma = eg.sigma.xyz;

                float t = -1.0;

                vec3 e_sphere = L * (center - mu);
                vec3 d_sphere = L * direction;
    
                float d_dot_d = dot(d_sphere, d_sphere);
                float o_dot_d = dot(e_sphere, d_sphere);

                float t_ca = -o_dot_d / d_dot_d;

                vec3 closest_point = e_sphere + t_ca * d_sphere;
                float d2 = dot(closest_point, closest_point);

                float Q2 = Q * Q;

                if (d2 <= Q2) {

                        float t_hc = sqrt(Q2 - d2) / sqrt(d_dot_d);
    
                        float t1 = t_ca - t_hc;
                        float t2 = t_ca + t_hc;

                        t = (t1 >= 0.0) ? t1 : t2;
                }
                
                if (t > 0.0)
                {
                    hit_info[hit_count].t = t;
                    hit_info[hit_count].prim_id = prim_id;
                    hit_info[hit_count].response = exp(-0.5f * d2);
                    hit_count++;
                }
            }

            // —ортируем пересечени€ по рассто€нию
            for (int i = 0; i < hit_count - 1; i++)
            {
                for (int j = 0; j < hit_count - i - 1; j++)
                {
                    if (hit_info[j].t > hit_info[j + 1].t)
                    {
                        HitInfo temp = hit_info[j];
                        hit_info[j] = hit_info[j + 1];
                        hit_info[j + 1] = temp;
                    }
                }
            }

            // ќбрабатываем пересечени€ в пор€дке возрастани€ рассто€ни€
            for (int i = 0; i < hit_count; i++)
            {
                uint prim_id = hit_info[i].prim_id;
                
                EllipsoidAddtitional ea = ellipsoid_addtitional[prim_id];

                float alpha = clamp(ea.opacity * hit_info[i].response, 0.0, 1.0);
                
                pixel_color.rgb += vec3(ea.sh_main[0], ea.sh_main[1], ea.sh_main[2]) * alpha * pixel_color.a;
                pixel_color.a *= (1.0 - alpha);
            }
        }
        else // ¬нутренний узел
        {
            float t_left = -1.0;
            float t_right = -1.0;
    
            if (node.index_left != -1)
            {
                BVH_Node left_node = nodes[node.index_left];
                vec3 left_min = vec3(left_node.bounds[0], left_node.bounds[2], left_node.bounds[4]);
                vec3 left_max = vec3(left_node.bounds[1], left_node.bounds[3], left_node.bounds[5]);
                t_left = intersect_aabb(center, inv_dir, left_min, left_max);
            }
    
            if (node.index_right != -1)
            {
                BVH_Node right_node = nodes[node.index_right];
                vec3 right_min = vec3(right_node.bounds[0], right_node.bounds[2], right_node.bounds[4]);
                vec3 right_max = vec3(right_node.bounds[1], right_node.bounds[3], right_node.bounds[5]);
                t_right = intersect_aabb(center, inv_dir, right_min, right_max);
            }
    
            // ≈сли оба пересекаютс€ Ч сначала ближайший
            // ≈сли пересекает только один Ч только его и добавл€ем
            // ѕор€док добавлени€ в стек: дальний, потом ближайший (чтобы ближний обработалс€ первым)
    
            if (t_left >= 0.0 && t_right >= 0.0)
            {
                // ќба пересекаютс€ Ч сначала дальний в стек, потом ближний
                if (t_left < t_right)
                {
                    stack[stack_ptr++] = node.index_right;  // дальний
                    stack[stack_ptr++] = node.index_left;   // ближний
                }
                else
                {
                    stack[stack_ptr++] = node.index_left;   // дальний
                    stack[stack_ptr++] = node.index_right;  // ближний
                }
            }
            else if (t_left >= 0.0)
            {
                stack[stack_ptr++] = node.index_left;
            }
            else if (t_right >= 0.0)
            {
                stack[stack_ptr++] = node.index_right;
            }
            // ≈сли оба -1, не добавл€ем ничего
        }
    }
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_tex);

    if (pos.x >= size.x || pos.y >= size.y) return;

    vec2 ndc = vec2(
        float(pos.x) * 2.0 / float(size.x) - 1.0,
        1.0 - float(pos.y) * 2.0 / float(size.y)
    );
    
    float tan_fov = tan(radians(fov) * 0.5);
    vec2 ray_ndc = vec2(ndc.x * aspect * tan_fov, ndc.y * tan_fov);

    vec3 ray_dir = normalize(camera_front + camera_right * ray_ndc.x - camera_up * ray_ndc.y);

    vec4 pixel_color = vec4(0.0, 0.0, 0.0, 1.0);
    float closest_hit = 1e30; // Ѕольшое число дл€ начальной дистанции

    traverse_bvh(camera_pos, ray_dir, pixel_color, closest_hit);

    imageStore(out_tex, pos, pixel_color);
}