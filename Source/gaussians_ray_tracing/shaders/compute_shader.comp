#version 430 core

layout (local_size_x = 8, local_size_y = 4, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D out_tex;

struct EllipsoidGPU
{
    vec4 mu;
    mat4 L;
};

struct EllipsoidAdditional
{
    float sh_main[3];
    float sh_add[45];
    float opacity;
};

struct BVH_Node
{
    float bounds[6];
    int index_left;
    int index_right;
    int primitive_counts;
    int primitive_index;
};

layout(std430, binding = 1) buffer EllipsoidsGPU
{
    EllipsoidGPU ellipsoid_general[];
};

layout(std430, binding = 2) buffer EllipsoidsAdditional
{
    EllipsoidAdditional ellipsoid_additional[];
};

layout(std430, binding = 3) buffer BVH_Nodes
{
    BVH_Node nodes[];
};

layout(std430, binding = 4) buffer BVH_Indices
{
    uint prim_ids[];
};

uniform vec3 camera_pos;
uniform vec3 camera_front;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform float fov;
uniform float aspect;
uniform float Q;
uniform vec3 light_pos;
uniform int ellipsoid_count;
uniform int bvh_index;

float intersect_aabb(vec3 center, vec3 dir, vec3 min_box, vec3 max_box)
{
    float tx1, tx2, ty1, ty2, tz1, tz2;

    bool no_intersection = false;

    float eps = 1e-6;

    if (abs(dir.x) < eps)
    {
        if (center.x < min_box.x || center.x > max_box.x)
        {
            no_intersection = true;
        }
        else
        {
            tx1 = -1e20;
            tx2 = 1e20;
        }
    }
    else
    {
        tx1 = (min_box.x - center.x) / dir.x;
        tx2 = (max_box.x - center.x) / dir.x;
    }

    if (abs(dir.y) < eps)
    {
        if (center.y < min_box.y || center.y > max_box.y)
        {
            no_intersection = true;
        }
        else
        {
            ty1 = -1e20;
            ty2 = 1e20;
        }
    }
    else
    {
        ty1 = (min_box.y - center.y) / dir.y;
        ty2 = (max_box.y - center.y) / dir.y;
    }

    if (abs(dir.z) < eps)
    {
        if (center.z < min_box.z || center.z > max_box.z)
        {
            no_intersection = true;
        }
        else
        {
            tz1 = -1e20;
            tz2 = 1e20;
        }
    }
    else
    {
        tz1 = (min_box.z - center.z) / dir.z;
        tz2 = (max_box.z - center.z) / dir.z;
    }

    if (no_intersection)
    {
        return -1.0;
    }

    float t_min_x = min(tx1, tx2);
    float t_max_x = max(tx1, tx2);
    float t_min_y = min(ty1, ty2);
    float t_max_y = max(ty1, ty2);
    float t_min_z = min(tz1, tz2);
    float t_max_z = max(tz1, tz2);


    float t_enter = max(t_min_x, max(t_min_y, t_min_z));
    float t_exit = min(t_max_x, min(t_max_y, t_max_z));

    if (t_exit < 0.0 || t_enter > t_exit)
    {
        return -1.0;
    }
    else
    {
        return max(t_enter, 0.0);
    }
}

struct HitInfo
{
    float t;
    uint prim_id;
    float response;
};

void traverse_bvh(vec3 center, vec3 direction, inout vec4 pixel_color)
{
    vec3 inv_dir = 1.0 / direction;
    
    int stack[64];
    int stack_ptr = 0;
    stack[stack_ptr++] = 0;

    HitInfo hit_info[256];
    int hit_count = 0;

    while (stack_ptr > 0)
    {
        int node_index = stack[--stack_ptr];
        BVH_Node node = nodes[node_index];

        vec3 bounds_min = vec3(node.bounds[0], node.bounds[2], node.bounds[4]);
        vec3 bounds_max = vec3(node.bounds[1], node.bounds[3], node.bounds[5]);
        
        float t_hit = intersect_aabb(center, direction, bounds_min, bounds_max);
        
        if (t_hit < 0.0)
            continue;

        if (node.primitive_counts > 0)
        {
            for (int i = 0; i < node.primitive_counts; i++)
            {
                uint prim_id = prim_ids[node.primitive_index + i];
                
                EllipsoidGPU eg = ellipsoid_general[prim_id];

                vec3 mu = vec3(eg.mu);
                mat3 L = mat3(eg.L);

                float t = -1.0;

                vec3 e_sphere = L * (center - mu);
                vec3 d_sphere = L * direction;

                float Q2 = Q * Q;

                vec3 inv_d = 1.0f / d_sphere;
                vec3 t0 = (-Q - e_sphere) * inv_d;
                vec3 t1 = ( Q - e_sphere) * inv_d;

                vec3 t_min_vec = min(t0, t1);
                vec3 t_max_vec = max(t0, t1);

                float t_min_aabb = max(max(t_min_vec.x, t_min_vec.y), t_min_vec.z);
                float t_max_aabb = min(min(t_max_vec.x, t_max_vec.y), t_max_vec.z);

                if (t_max_aabb < 0.0f || t_min_aabb > t_max_aabb)
                {
                    continue; // Нет пересечения с AABB сферы
                }

                float t_entry_aabb = max(t_min_aabb, 0.0f);

                vec3 new_origin = e_sphere + t_entry_aabb * d_sphere;

                float d_dot_d = dot(d_sphere, d_sphere);
                float o_dot_d = dot(new_origin, d_sphere);

                float t_ca = -o_dot_d / d_dot_d;

                vec3 closest_point = new_origin + t_ca * d_sphere;

                float d2 = dot(closest_point, closest_point);

                if (d2 <= Q2 + 1e-6f) {

                        float t_hc = sqrt(Q2 - d2) / sqrt(d_dot_d);
    
                        float t1 = t_ca - t_hc;
                        float t2 = t_ca + t_hc;

                        t = (t1 >= 0.0) ? t1 : t2;
                        t += t_entry_aabb;
                }
                
                if (t > 0.0)
                {
                    vec3 max_response_point = e_sphere - dot(e_sphere, d_sphere) / dot(d_sphere, d_sphere) * d_sphere;

                    hit_info[hit_count].t = t;
                    hit_info[hit_count].prim_id = prim_id;
                    hit_info[hit_count].response = exp(-0.5f * dot(max_response_point,max_response_point));
                    hit_count++;
                }
            }
        }
        else
        {
            float t_left = -1.0;
            float t_right = -1.0;
    
            if (node.index_left != -1)
            {
                BVH_Node left_node = nodes[node.index_left];
                vec3 left_min = vec3(left_node.bounds[0], left_node.bounds[2], left_node.bounds[4]);
                vec3 left_max = vec3(left_node.bounds[1], left_node.bounds[3], left_node.bounds[5]);
                t_left = intersect_aabb(center, direction, left_min, left_max);
            }
    
            if (node.index_right != -1)
            {
                BVH_Node right_node = nodes[node.index_right];
                vec3 right_min = vec3(right_node.bounds[0], right_node.bounds[2], right_node.bounds[4]);
                vec3 right_max = vec3(right_node.bounds[1], right_node.bounds[3], right_node.bounds[5]);
                t_right = intersect_aabb(center, direction, right_min, right_max);
            }
    
            if (t_left >= 0.0 && t_right >= 0.0)
            {
                if (t_left < t_right)
                {
                    stack[stack_ptr++] = node.index_right;
                    stack[stack_ptr++] = node.index_left;
                }
                else
                {
                    stack[stack_ptr++] = node.index_left;
                    stack[stack_ptr++] = node.index_right;
                }
            }
            else if (t_left >= 0.0)
            {
                stack[stack_ptr++] = node.index_left;
            }
            else if (t_right >= 0.0)
            {
                stack[stack_ptr++] = node.index_right;
            }
        }
    }

    for (int i = 0; i < hit_count - 1; i++)
    {
        for (int j = 0; j < hit_count - i - 1; j++)
        {
            if (hit_info[j].t > hit_info[j + 1].t)
            {
                HitInfo temp = hit_info[j];
                hit_info[j] = hit_info[j + 1];
                hit_info[j + 1] = temp;
            }
        }
    }
    
    for (int i = 0; i < hit_count; i++)
    {
        uint prim_id = hit_info[i].prim_id;

        EllipsoidAdditional ea = ellipsoid_additional[prim_id];

        vec3 color = vec3(ea.sh_main[0], ea.sh_main[1], ea.sh_main[2]);
    
        float alpha = clamp(ea.opacity * hit_info[i].response, 0.0, 1.0);
    
        pixel_color.rgb += color * alpha * pixel_color.a;
        pixel_color.a *= (1.0 - alpha);
    }
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_tex);

    if (pos.x >= size.x || pos.y >= size.y) return;

    vec2 ndc = vec2(
        float(pos.x) * 2.0 / float(size.x) - 1.0,
        1.0 - float(pos.y) * 2.0 / float(size.y)
    );
    
    float tan_fov = tan(radians(fov) * 0.5);
    vec2 ray_ndc = vec2(ndc.x * aspect * tan_fov, ndc.y * tan_fov);

    vec3 ray_dir = normalize(camera_front + camera_right * ray_ndc.x - camera_up * ray_ndc.y);

    vec4 pixel_color = vec4(0.0, 0.0, 0.0, 1.0);

    traverse_bvh(camera_pos, ray_dir, pixel_color);

    imageStore(out_tex, pos, pixel_color);
}