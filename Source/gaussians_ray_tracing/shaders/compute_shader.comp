#version 430 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D out_tex;

struct Ellipsoid
{
    float mu[3];
    float sigma[3];
    float quaternion[4];
    float sh_dc[3];
    float sh_rest[45];
    float opacity;
    float Q;
};

layout(std430, binding = 1) buffer Ellipsoids
{
    Ellipsoid ellipsoids[];
};

uniform vec3 camera_pos;
uniform vec3 camera_front;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform float fov;
uniform float aspect;

vec3 mat3_mul_vec3(mat3 m, vec3 v)
{
    return vec3(
        m[0].x * v.x + m[0].y * v.y + m[0].z * v.z,
        m[1].x * v.x + m[1].y * v.y + m[1].z * v.z,
        m[2].x * v.x + m[2].y * v.y + m[2].z * v.z
    );
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_tex);
    
    if (pos.x >= size.x || pos.y >= size.y) 
    {
        return;
    }

    vec2 ndc = vec2(
        float(pos.x) * 2.0 / float(size.x) - 1.0, 
        1.0 - float(pos.y) * 2.0 / float(size.y)
    );
    
    float tan_fov = tan(radians(fov) / 2.0);
    vec2 ray_dir_ndc = ndc;
    ray_dir_ndc.x *= aspect * tan_fov;
    ray_dir_ndc.y *= tan_fov;
    
    vec3 ray_dir = normalize(camera_front + camera_right * ray_dir_ndc.x - camera_up * ray_dir_ndc.y);
    
    vec4 pixel_color = vec4(0.0, 0.0, 0.0, 1.0);
    float closest_t = 1e10;
    
    for (int i = 0; i < ellipsoids.length(); i++)
    {
        vec3 mu = vec3(ellipsoids[i].mu[0], ellipsoids[i].mu[1], ellipsoids[i].mu[2]);
        vec3 sigma = vec3(ellipsoids[i].sigma[0], ellipsoids[i].sigma[1], ellipsoids[i].sigma[2]);

        mat3 cov_recip = mat3(
            vec3(1.0 / (sigma.x * sigma.x), 0.0, 0.0),
            vec3(0.0, 1.0 / (sigma.y * sigma.y), 0.0),
            vec3(0.0, 0.0, 1.0 / (sigma.z * sigma.z))
        );
        
        vec3 oc = camera_pos - mu;

        vec3 temp_a = mat3_mul_vec3(cov_recip, ray_dir);
        float a = dot(ray_dir, temp_a);
        
        vec3 temp_b = mat3_mul_vec3(cov_recip, ray_dir);
        float b = 2.0 * dot(oc, temp_b);
        
        vec3 temp_c = mat3_mul_vec3(cov_recip, oc);
        float c = dot(oc, temp_c) - ellipsoids[i].Q;
        
        float discriminant = b * b - 4.0 * a * c;
        
        if (discriminant >= 0.0)
        {
            float sqrt_disc = sqrt(discriminant);
            float t1 = (-b - sqrt_disc) / (2.0 * a);
            float t2 = (-b + sqrt_disc) / (2.0 * a);
            
            float t = -1.0;
            if (t1 > 0.0 && t2 > 0.0) {
                t = min(t1, t2);
            } else if (t1 > 0.0) {
                t = t1;
            } else if (t2 > 0.0) {
                t = t2;
            }
            
            if (t > 0.0)
            {
                vec3 sh0_color = vec3(
                    clamp(0.2820947918 * ellipsoids[i].sh_dc[0] + 0.5, 0, 1), 
                    clamp(0.2820947918 * ellipsoids[i].sh_dc[1] + 0.5, 0, 1), 
                    clamp(0.2820947918 * ellipsoids[i].sh_dc[2] + 0.5, 0, 1)
                );
                pixel_color += vec4(sh0_color * ellipsoids[i].opacity, 1.0);
            }
        }
    }
    
    imageStore(out_tex, pos, pixel_color);
}