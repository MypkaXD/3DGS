#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D out_tex;

struct EllipsoidGPU
{
    vec4 mu;
    mat4 L;
};

struct EllipsoidAdditional
{
    float sh_main[3];
    // float sh_add[45];
    float opacity;
};

struct BVH_Node
{
    float bounds[6];
    int index_left;
    int index_right;
    int primitive_counts;
    int primitive_index;
};

layout(std430, binding = 1) buffer EllipsoidsGPU
{
    EllipsoidGPU ellipsoid_general[];
};

layout(std430, binding = 2) buffer EllipsoidsAdditional
{
    EllipsoidAdditional ellipsoid_additional[];
};

layout(std430, binding = 3) buffer BVH_Nodes
{
    BVH_Node nodes[];
};

layout(std430, binding = 4) buffer BVH_Indices
{
    uint prim_ids[];
};

uniform vec3 camera_pos;
uniform vec3 camera_front;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform float fov;
uniform float aspect;
uniform float Q;
uniform vec3 light_pos;
uniform int ellipsoid_count;
uniform int bvh_index; // индекс корневого узла BVH — теперь реально используется

// Жёсткий предел итераций марша, чтобы исключить зависание/TDR на плотных сценах.
// При необходимости можно вынести в uniform.
#define MAX_MARCH_STEPS 256
// Порог накопленной прозрачности, после которого дальнейший вклад незначим.
#define TRANSMIT_THRESHOLD 1e-3

// Параметры затенения. Можно вынести в uniform'ы, если нужен контроль с host-стороны.
#define AMBIENT_STRENGTH 0.25
#define DIFFUSE_STRENGTH 0.75
#define LIGHT_ATTENUATION_ENABLED 1
#define LIGHT_RADIUS_FALLOFF 4.0 // масштаб дистанции для attenuation, подберите под сцену

struct HitInfo
{
    float t;
    uint prim_id;
    float response;
};

// Безопасное обратное направление: защита от NaN на осевых лучах / гранях AABB через origin
vec3 safe_inv_dir(vec3 direction)
{
    const float eps = 1e-8;
    vec3 d = direction;
    if (abs(d.x) < eps) d.x = (d.x >= 0.0) ? eps : -eps;
    if (abs(d.y) < eps) d.y = (d.y >= 0.0) ? eps : -eps;
    if (abs(d.z) < eps) d.z = (d.z >= 0.0) ? eps : -eps;
    return 1.0 / d;
}

float intersect_aabb(vec3 center, vec3 inv_dir, vec3 min_box, vec3 max_box)
{
    vec3 t1 = (min_box - center) * inv_dir;
    vec3 t2 = (max_box - center) * inv_dir;

    vec3 t_min = min(t1, t2);
    vec3 t_max = max(t1, t2);

    float t_enter = max(max(t_min.x, t_min.y), t_min.z);
    float t_exit  = min(min(t_max.x, t_max.y), t_max.z);

    return (t_exit >= t_enter && t_exit > 0.0) ? max(t_enter, 0.0) : -1.0;
}

// Псевдонормаль в точке пересечения луча с гауссианом.
// У гауссиана нет явной поверхности, но градиент функции плотности
// rho(x) = exp(-0.5 * (x-mu)^T * Sigma^-1 * (x-mu))
// направлен наружу и хорошо работает как нормаль для затенения.
// Поскольку e_sphere = L * (x - mu), имеем Sigma^-1 = L^T * L,
// то есть градиент ~ transpose(L) * (L * (x - mu)) = transpose(L) * e_sphere.
vec3 gaussian_pseudo_normal(mat3 L, vec3 e_sphere_at_hit)
{
    vec3 grad = transpose(L) * e_sphere_at_hit;
    float len2 = dot(grad, grad);
    if (len2 < 1e-12) return vec3(0.0, 1.0, 0.0); // вырожденный случай — произвольная нормаль
    return grad * inversesqrt(len2);
}

// Простое затенение по Ламберту + ambient-подсветка, чтобы тени не были чисто чёрными.
vec3 shade_point(vec3 world_pos, vec3 normal, vec3 base_color)
{
    vec3 to_light = light_pos - world_pos;
    float dist2 = dot(to_light, to_light);
    vec3 light_dir = to_light * inversesqrt(max(dist2, 1e-6));

    float ndotl = max(dot(normal, light_dir), 0.0);

#if LIGHT_ATTENUATION_ENABLED
    float attenuation = LIGHT_RADIUS_FALLOFF / (LIGHT_RADIUS_FALLOFF + dist2);
#else
    float attenuation = 1.0;
#endif

    float shading = AMBIENT_STRENGTH + DIFFUSE_STRENGTH * ndotl * attenuation;
    return base_color * shading;
}

void any_hit(vec3 center, vec3 direction, vec3 inv_dir, int root_index, inout HitInfo hits[32], inout int hit_count)
{
    int stack[64];
    int stack_ptr = 0;
    stack[stack_ptr++] = root_index;

    float Q2 = Q * Q;
    const int max_hits = 32;

    float t_max = -1.0;
    hit_count = 0;

    while (stack_ptr > 0)
    {
        int node_index = stack[--stack_ptr];
        BVH_Node node = nodes[node_index];

        if (node.primitive_counts > 0) // Leaf node
        {
            for (int i = 0; i < node.primitive_counts; ++i)
            {
                uint prim_id = prim_ids[node.primitive_index + i];

                vec3 mu = vec3(ellipsoid_general[prim_id].mu.xyz);
                mat3 L = mat3(ellipsoid_general[prim_id].L);

                vec3 e_sphere = L * (center - mu);
                vec3 d_sphere = L * direction;

                float d_dot_d = dot(d_sphere, d_sphere);

                // Направление вырождено в трансформированном пространстве — пропускаем примитив
                if (d_dot_d < 1e-10) continue;

                float o_dot_d = dot(e_sphere, d_sphere);
                float t_ca = -o_dot_d / d_dot_d;

                vec3 closest_point = e_sphere + t_ca * d_sphere;
                float d2 = dot(closest_point, closest_point);

                float current_t = -1.0;

                if (d2 <= Q2 + 1e-6)
                {
                    // max(0, ...) — критично: без этого sqrt от отрицательного числа даёт NaN
                    float discriminant = max(0.0, Q2 - d2);
                    float t_hc = sqrt(discriminant / d_dot_d);

                    float t1 = t_ca - t_hc;
                    float t2 = t_ca + t_hc;

                    if (t1 >= 0.0)
                        current_t = t1;
                    else if (t2 >= 0.0)
                        current_t = t2;
                }

                if (current_t > 0.0)
                {
                    if (hit_count < max_hits)
                    {
                        hits[hit_count].t = current_t;
                        hits[hit_count].prim_id = prim_id;
                        hits[hit_count].response = exp(-0.5 * d2);
                        hit_count++;
                        if (hit_count == max_hits)
                        {
                            t_max = hits[0].t;
                            for (int k = 1; k < max_hits; ++k)
                                t_max = max(t_max, hits[k].t);
                        }
                    }
                    else if (current_t < t_max)
                    {
                        int worst = 0;
                        float worst_t = hits[0].t;
                        for (int k = 1; k < max_hits; ++k)
                        {
                            if (hits[k].t > worst_t) { worst_t = hits[k].t; worst = k; }
                        }
                        hits[worst].t = current_t;
                        hits[worst].prim_id = prim_id;
                        hits[worst].response = exp(-0.5 * d2);

                        t_max = hits[0].t;
                        for (int k = 1; k < max_hits; ++k)
                            t_max = max(t_max, hits[k].t);
                    }
                }
            }
        }
        else // Internal node
        {
            vec3 min_l = vec3(nodes[node.index_left].bounds[0],  nodes[node.index_left].bounds[2],  nodes[node.index_left].bounds[4]);
            vec3 max_l = vec3(nodes[node.index_left].bounds[1],  nodes[node.index_left].bounds[3],  nodes[node.index_left].bounds[5]);
            vec3 min_r = vec3(nodes[node.index_right].bounds[0], nodes[node.index_right].bounds[2], nodes[node.index_right].bounds[4]);
            vec3 max_r = vec3(nodes[node.index_right].bounds[1], nodes[node.index_right].bounds[3], nodes[node.index_right].bounds[5]);

            float t_left  = intersect_aabb(center, inv_dir, min_l, max_l);
            float t_right = intersect_aabb(center, inv_dir, min_r, max_r);

            // Кладём дальний узел первым, ближний — вторым (LIFO снимет ближний раньше).
            // Дополнительно проверяем stack_ptr < 64, чтобы исключить overflow.
            if (t_left < t_right)
            {
                if (t_right >= 0.0 && stack_ptr < 64) stack[stack_ptr++] = node.index_right;
                if (t_left  >= 0.0 && stack_ptr < 64) stack[stack_ptr++] = node.index_left;
            }
            else
            {
                if (t_left  >= 0.0 && stack_ptr < 64) stack[stack_ptr++] = node.index_left;
                if (t_right >= 0.0 && stack_ptr < 64) stack[stack_ptr++] = node.index_right;
            }
        }
    }
}

void traverse_bvh(vec3 center, vec3 direction, inout vec4 pixel_color)
{
    vec3 inv_dir = safe_inv_dir(direction);

    for (int step = 0; step < MAX_MARCH_STEPS; ++step)
    {
        if (pixel_color.a < TRANSMIT_THRESHOLD) break;

        HitInfo hit_info[32];
        int hit_count = 0;
        any_hit(center, direction, inv_dir, bvh_index, hit_info, hit_count);

        if (hit_count == 0) break;

        // Сортировка по возрастанию t (front-to-back) перед compositing
        for (int i = 0; i < hit_count - 1; i++)
        {
            for (int j = 0; j < hit_count - i - 1; j++)
            {
                if (hit_info[j].t > hit_info[j + 1].t)
                {
                    HitInfo temp = hit_info[j];
                    hit_info[j] = hit_info[j + 1];
                    hit_info[j + 1] = temp;
                }
            }
        }

        bool terminated_early = false;
        for (int i = 0; i < hit_count; i++)
        {
            if (pixel_color.a < TRANSMIT_THRESHOLD)
            {
                terminated_early = true;
                break;
            }

            uint prim_id = hit_info[i].prim_id;
            EllipsoidAdditional ea = ellipsoid_additional[prim_id];

            vec3 base_color = vec3(ea.sh_main[0], ea.sh_main[1], ea.sh_main[2]);
            float alpha = clamp(ea.opacity * hit_info[i].response, 0.0, 1.0);

            pixel_color.rgb += alpha * pixel_color.a;
            pixel_color.a *= (1.0 - alpha);
        }

        if (terminated_early) break;

        // Аддитивный (не мультипликативный!) эпсилон — исключает "залипание" при t_max ~ 0
        float t_max = hit_info[hit_count - 1].t;
        center += direction * (t_max + 1e-4);
    }

    pixel_color.a = clamp(pixel_color.a, 0.0, 1.0);
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_tex);

    if (pos.x >= size.x || pos.y >= size.y) return;

    vec2 ndc = vec2(
        float(pos.x) * 2.0 / float(size.x) - 1.0,
        1.0 - float(pos.y) * 2.0 / float(size.y)
    );

    float tan_fov = tan(radians(fov) * 0.5);
    vec2 ray_ndc = vec2(ndc.x * aspect * tan_fov, ndc.y * tan_fov);

    vec3 ray_dir = normalize(camera_front + camera_right * ray_ndc.x - camera_up * ray_ndc.y);

    vec4 pixel_color = vec4(0.0, 0.0, 0.0, 1.0);

    traverse_bvh(camera_pos, ray_dir, pixel_color);

    pixel_color.rgb = clamp(pixel_color.rgb, 0.0, 1.0);

    imageStore(out_tex, pos, pixel_color);
}
