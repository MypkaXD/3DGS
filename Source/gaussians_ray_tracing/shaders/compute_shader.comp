#version 430 core

layout (local_size_x = 8, local_size_y = 4, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform image2D out_tex;

struct EllipsoidGeneral
{
	vec4 mu;
	vec4 sigma;
	mat4 rotation;
	mat4 covariance_invariant;
};

struct EllipsoidAddtitional
{
	vec4 sh_main;
	vec4 sh_add[15];
	float opacity;
};

struct BVH_Node
{
	float bounds[6];

	int index_left;
	int index_right;

	int primitive_counts;
	int primitive_index;
};

layout(std430, binding = 1) buffer EllipsoidsGeneral
{
    EllipsoidGeneral ellipsoid_general[];
};

layout(std430, binding = 2) buffer EllipsoidsAddtitional
{
    EllipsoidAddtitional ellipsoid_addtitional[];
};

layout(std430, binding = 3) buffer BVH_Nodes
{
    BVH_Node nodes[];
};

layout(std430, binding = 4) buffer BVH_Indices
{
    uint prim_ids[];
};

uniform vec3 camera_pos;
uniform vec3 camera_front;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform float fov;
uniform float aspect;
uniform float Q;

bool intersectRayAABB(vec3 origin, vec3 dir, vec3 bounds_min, vec3 bounds_max)
{
    vec3 inv_dir = 1.0 / dir;

    vec3 t1 = (bounds_min - origin) * inv_dir;
    vec3 t2 = (bounds_max - origin) * inv_dir;
    
    vec3 tmin_vec = min(t1, t2);
    vec3 tmax_vec = max(t1, t2);
    
    float tmin = max(max(tmin_vec.x, tmin_vec.y), tmin_vec.z);
    float tmax = min(min(tmax_vec.x, tmax_vec.y), tmax_vec.z);

    return tmin <= tmax && tmax > 0.0;
}

void traverse_bvh(vec3 ray_origin, vec3 ray_dir, inout vec4 pixel_color)
{
    int stack[64];
    int stack_ptr = 0;
    stack[stack_ptr++] = 0;
    
    while (stack_ptr > 0)
    {
        int node_idx = stack[--stack_ptr];
        
        if (node_idx < 0)
            continue;
            
        BVH_Node node = nodes[node_idx];
        
        vec3 bounds_min = vec3(node.bounds[0], node.bounds[2], node.bounds[4]);
        vec3 bounds_max = vec3(node.bounds[1], node.bounds[3], node.bounds[5]);
        
        if (!intersectRayAABB(ray_origin, ray_dir, bounds_min, bounds_max))
            continue;
        
        if (node.primitive_counts > 0)
        {
            for (int i = node.primitive_index; i < node.primitive_index + node.primitive_counts; i++)
            {
                uint ell_idx = prim_ids[i];
                EllipsoidGeneral ell_gen = ellipsoid_general[ell_idx];
        
                vec3 oc = ray_origin - ell_gen.mu.xyz;
                mat3 temp = mat3(ell_gen.covariance_invariant);
                float a = dot(ray_dir, temp * ray_dir);
                float b = 2.0 * dot(oc, temp * ray_dir);
                float c = dot(oc, temp * oc) - Q;
        
                float discriminant = b * b - 4.0 * a * c;
        
                if (discriminant >= 0.0)
                {
                    float sqrt_disc = sqrt(discriminant);
                    float t1 = (-b - sqrt_disc) / (2.0 * a);
                    float t2 = (-b + sqrt_disc) / (2.0 * a);
            
                    float t = -1.0;
                    if (t1 > 0.0 && t2 > 0.0) {
                        t = min(t1, t2);
                    } else if (t1 > 0.0) {
                        t = t1;
                    } else if (t2 > 0.0) {
                        t = t2;
                    }
            
                    if (t > 0.0)
                    {
                        EllipsoidAddtitional ell_add = ellipsoid_addtitional[ell_idx];
                        vec3 sh0_color = vec3(
                            clamp(0.2820947918 * ell_add.sh_main[0] + 0.5, 0, 1), 
                            clamp(0.2820947918 * ell_add.sh_main[1] + 0.5, 0, 1), 
                            clamp(0.2820947918 * ell_add.sh_main[2] + 0.5, 0, 1)
                        );
                        pixel_color.rgb += sh0_color * ell_add.opacity;
                    }
                }
            }
        }
        else
        {
            if (node.index_right >= 0)
                stack[stack_ptr++] = node.index_right;
            if (node.index_left >= 0)
                stack[stack_ptr++] = node.index_left;
        }
    }
}

void main()
{
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_tex);
    
    if (pos.x >= size.x || pos.y >= size.y) 
        return;

    vec2 ndc = vec2(
        float(pos.x) * 2.0 / float(size.x) - 1.0, 
        1.0 - float(pos.y) * 2.0 / float(size.y)
    );
    
    float tan_fov = tan(radians(fov) / 2.0);
    vec2 ray_dir_ndc = ndc;
    ray_dir_ndc.x *= aspect * tan_fov;
    ray_dir_ndc.y *= tan_fov;
    
    vec3 ray_dir = normalize(camera_front + camera_right * ray_dir_ndc.x - camera_up * ray_dir_ndc.y);
    
    vec4 pixel_color = vec4(0.0, 0.0, 0.0, 1.0);

    traverse_bvh(camera_pos, ray_dir, pixel_color);
    
    imageStore(out_tex, pos, pixel_color);
}